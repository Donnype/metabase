{
  "description": "A block (the FE's sidebar group): a heading plus its pages. `:type` is whether the block is\n   anchored on its metric or its dimension; `:name` is the computed heading (the metric name, or\n   `By <dimension>`). `:position` is the block's 0-indexed authoring slot.",
  "properties": {
    "explore_filters": {
      "oneOf": [
        {
          "items": {
            "properties": {
              "dimension_name": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "display_value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "field_ref": {
                "items": {},
                "type": "array"
              },
              "value": {}
            },
            "required": [
              "field_ref",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "value must be an integer greater than zero.",
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pages": {
      "items": {
        "$ref": "./metabase.explorations.api.ExplorationPageNode.json"
      },
      "type": "array"
    },
    "position": {
      "description": "value must be an integer greater or equal to than zero.",
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "enum": [
        "metric",
        "dimension"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "position",
    "pages"
  ],
  "type": "object"
}
